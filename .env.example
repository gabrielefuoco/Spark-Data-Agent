# ---- LLM backend -------------------------------------------------------------
# ollama      : local, free, no token cost — the development default
# openrouter  : remote, paid, needed for the reasoning critic
LLM_BACKEND=ollama

OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:7b

# Leave empty in local mode.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
REMOTE_ROUTER_MODEL=deepseek/deepseek-chat
REMOTE_REASONING_MODEL=deepseek/deepseek-r1

# ---- Storage -----------------------------------------------------------------
# Local directory, or s3a://lakehouse/ when running against MinIO.
SPARK_STORAGE_URI=./data

# Only needed for the S3/MinIO connector (ticket 06).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_ENDPOINT_URL=

# ---- Agent behaviour ---------------------------------------------------------
MIN_SUBJECTS_PER_CLASS=30
SQL_ROW_LIMIT=500
HITL_COST_THRESHOLD=1.0
MAX_QUERY_RETRIES=2
